# Copier en .env (jamais commité, voir .gitignore) puis adapter.
# Lu par docker compose (substitution et env_file).

# dev : /docs visible, authentification facultative
# prod : authentification obligatoire, /docs masqué (ADR-0005, ADR-0006)
APP_ENV=dev

# Version du modèle chargée depuis artifacts/models/<version> (monté sur /models)
MODEL_VERSION=1.1.0
PREDICTION_THRESHOLD=0.5
RATE_LIMIT_PER_MINUTE=60

# Authentification (obligatoire si APP_ENV=prod)
# Générer une entrée avec : python scripts/create_api_key.py --id front --role user --days 30
# AUTH_ENABLED=true
# API_KEYS=front:<empreinte>:user:<AAAA-MM-JJ>

# Étiquettes de l'image
APP_VERSION=1.0.0
VCS_REF=local
